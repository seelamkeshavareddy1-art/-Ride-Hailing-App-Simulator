<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_screen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_header"
            android:padding="24dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RideGo"
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"/>

            <TextView
                android:id="@+id/tvWelcomeRider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Welcome to RideGo!"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginTop="20dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Where would you like to go today?"
                android:textSize="14sp"
                android:textColor="#E0E7FF"
                android:layout_marginTop="8dp"/>

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Book Your Ride"
            android:textSize="23sp"
            android:textStyle="bold"
            android:textColor="#182344"
            android:layout_marginBottom="16dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp"
            android:elevation="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PICKUP LOCATION"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#4C5875"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/etPickup"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Enter pickup location"
                android:singleLine="true"
                android:padding="14dp"
                android:textSize="14sp"
                android:background="@drawable/bg_input"/>

            <EditText
                android:id="@+id/etPickupLatitude"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Pickup latitude (e.g. 17.3850)"
                android:inputType="numberDecimal|numberSigned"
                android:padding="14dp"
                android:textSize="14sp"
                android:background="@drawable/bg_input"
                android:layout_marginTop="12dp"/>

            <EditText
                android:id="@+id/etPickupLongitude"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Pickup longitude (e.g. 78.4867)"
                android:inputType="numberDecimal|numberSigned"
                android:padding="14dp"
                android:textSize="14sp"
                android:background="@drawable/bg_input"
                android:layout_marginTop="10dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DROP LOCATION"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#4C5875"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/etDrop"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Enter destination"
                android:singleLine="true"
                android:padding="14dp"
                android:textSize="14sp"
                android:background="@drawable/bg_input"/>

            <EditText
                android:id="@+id/etDropLatitude"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Drop latitude"
                android:inputType="numberDecimal|numberSigned"
                android:padding="14dp"
                android:textSize="14sp"
                android:background="@drawable/bg_input"
                android:layout_marginTop="12dp"/>

            <EditText
                android:id="@+id/etDropLongitude"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Drop longitude"
                android:inputType="numberDecimal|numberSigned"
                android:padding="14dp"
                android:textSize="14sp"
                android:background="@drawable/bg_input"
                android:layout_marginTop="10dp"/>

            <Button
                android:id="@+id/btnBookRide"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="BOOK A RIDE"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:backgroundTint="#3158C9"
                android:layout_marginTop="24dp"/>

            <Switch
                android:id="@+id/switchSurgeFare"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enable Surge Pricing (1.5x)"
                android:textSize="16sp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:checked="false" />

            <Button
                android:id="@+id/btnCancelRide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cancel Ride"
                android:layout_marginTop="12dp"
                android:backgroundTint="#D32F2F"
                android:textColor="#FFFFFF"
                android:enabled="false"/>
            <Button
                android:id="@+id/btnCompleteRide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Complete Ride"
                android:layout_marginTop="12dp"
                android:backgroundTint="#2E7D32"
                android:textColor="#FFFFFF"
                android:enabled="false"/>
            <Button
                android:id="@+id/btnRideHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="View Ride History"
                android:textAllCaps="false"
                android:layout_marginTop="12dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your RideGo journey starts here."
            android:textSize="13sp"
            android:textColor="#8992A8"
            android:layout_gravity="center"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="20dp"/>

    </LinearLayout>

</ScrollView>
