<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_screen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_header"
            android:padding="24dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RideGo"
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"/>

            <TextView
                android:id="@+id/tvWelcomeDriver"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Welcome, Driver!"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginTop="20dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Drive safely. Earn more."
                android:textSize="14sp"
                android:textColor="#E0E7FF"
                android:layout_marginTop="8dp"/>

        </LinearLayout>

        <!-- Dashboard heading -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Driver Dashboard"
            android:textSize="23sp"
            android:textStyle="bold"
            android:textColor="#182344"
            android:layout_marginBottom="16dp"/>

        <!-- Availability card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp"
            android:elevation="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="YOUR STATUS"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#4C5875"/>

            <TextView
                android:id="@+id/tvDriverStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Currently Available"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#16834A"
                android:layout_marginTop="10dp"/>

            <Button
                android:id="@+id/btnAvailability"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="GO OFFLINE"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:backgroundTint="#3158C9"
                android:layout_marginTop="18dp"/>

        </LinearLayout>

        <!-- Earnings card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp"
            android:elevation="4dp"
            android:layout_marginTop="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="YOUR EARNINGS"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#4C5875"/>

            <TextView
                android:id="@+id/tvDriverEarnings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹0.00"
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="#182344"
                android:layout_marginTop="10dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total earnings"
                android:textSize="13sp"
                android:textColor="#8992A8"
                android:layout_marginTop="5dp"/>

        </LinearLayout>

        <!-- Ride requests -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ride Requests"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#182344"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvNoRequests"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No new ride requests"
                android:textSize="14sp"
                android:textColor="#8992A8"
                android:gravity="center"
                android:padding="16dp"/>

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Thank you for driving with RideGo!"
            android:textSize="13sp"
            android:textColor="#8992A8"
            android:gravity="center"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="20dp"/>

    </LinearLayout>

</ScrollView>
